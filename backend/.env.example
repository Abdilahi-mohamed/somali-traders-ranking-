PORT=4000
FRONTEND_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=somali_traders
# Generate a random secret with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_TOKEN_SECRET=replace-with-a-random-secret-at-least-32-characters
# Set all three once to provision the first administrator. Existing credentials are not overwritten.
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Server-side MetaApi token. Never expose this value to the frontend.
METAAPI_TOKEN=
# MetaApi Provisioning API base URL.
METAAPI_BASE_URL=https://mt-provisioning-api-v1.agiliumtrade.agiliumtrade.ai
# MetaApi client API region assigned to your account, e.g. new-york.
METAAPI_REGION=new-york
